# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
HF_HUB_OFFLINE=false

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
REPLY_TO_EMAIL=your_email@gmail.com
SENDER_NAME=Your Name
COMPANY_NAME=Your Company

# Application Settings
DRY_RUN_MODE=true
REQUIRE_EMAIL_APPROVAL=true
RATE_LIMIT_PER_MINUTE=10
MAX_RETRIES=2
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=1.5
PIPELINE_WORKER_ENABLED=true
APP_ENV=development
API_AUTH_TOKEN=
ADMIN_API_TOKEN=
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_PATH=./data/leads.db
DATABASE_URL=

# Docker Compose / PostgreSQL
POSTGRES_DB=leadgen
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=change-this-password
POSTGRES_URL=postgresql+psycopg://leadgen:change-this-password@db:5432/leadgen

# API Settings
API_PORT=8000
FRONTEND_PORT=3000

# n8n Configuration (Remote Server)
N8N_URL=https://your-n8n-instance.com
N8N_WORKFLOW_ID=your-workflow-id

# Lead Data Fields (from Facebook Lead Ads / Google Sheets)
# Required: name, email, phone, job_title, company, comments
